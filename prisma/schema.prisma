// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For email/password auth
  role          UserRole  @default(STUDENT)
  grade         String?   // For students: "9th", "10th", "11th", "12th"
  school        String?   // Current school
  bio           String?   @db.Text
  phone         String?
  timezone      String?   @default("America/New_York")
  
  // Student-specific fields
  targetSchools String[]  // Array of target college names
  interests     String[]  // Academic interests/majors
  parentEmail   String?   // Parent's email for notifications
  
  // Mentor-specific fields
  university    String?   // University they attend/attended
  major         String?   // Their major
  graduationYear Int?     // Year they graduated/will graduate
  expertise     String[]  // Areas of expertise
  hourlyRate    Float?    // Hourly rate for sessions
  calendlyLink  String?   // Calendly link for booking sessions
  
  // Relationships
  accounts      Account[]
  sessions      Session[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Enums
enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum MeetingStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingType {
  ONE_ON_ONE
  GROUP
  WORKSHOP
  CONSULTATION
} 